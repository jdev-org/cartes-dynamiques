{{#features}}
<li id="{{feature_ol_uid}}" class="item" style="width:100%;">	
	<div id="container" class="travaux_card_container">
		<div id="travaux_card_nature_chantier_{{feature_ol_uid}}" class="travaux_card_title">Éditer les informations</div>
        <div class="travaux_card_ref_chantier">Référence Chantier : {{num_emprise}}</div>
        <form>
            <div class="travaux_card_content_select">
                <label for="select_nature_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Nature du chantier</label>
                <select id="select_nature_chantier_{{feature_ol_uid}}">
                    <option value="">Sélectionnez une nature de chantier...</option>
                </select>
            </div>
            <div id="form_{{feature_ol_uid}}">
                <div class="travaux_card_content_select">
                    <label for="select_type_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Type de chantier</label>
                    <select id="select_type_chantier_{{feature_ol_uid}}" disabled>
                        <option value="">Sélectionnez un type de chantier...</option>
                    </select>
                </div>
                <div class="travaux_card_content">
                    <span class="travaux_card_subtitle">Impact sur l'espace public</span>
                    <textarea id="travaux_impact_{{feature_ol_uid}}" class="travaux_impact" disabled></textarea>
                </div>
            </div>
            <div id="autre_form_{{feature_ol_uid}}" class="autre_form">
                <div class="travaux_card_content">
                    <label for="input_autre_nature_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Précisez la nature du chantier</label>
                    <input type="text" id="input_autre_nature_chantier_{{feature_ol_uid}}"/>
                </div>
                <div class="travaux_card_content">
                    <label for="input_autre_type_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Précisez le type de chantier</label>
                    <input type="text" id="input_autre_type_chantier_{{feature_ol_uid}}"/>
                </div>
                <div class="travaux_card_content">
                    <label for="autre_impact_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Précisez l'impact sur l'espace public</label>
                    <textarea id="autre_impact_chantier_{{feature_ol_uid}}" class="autre_impact_chantier"></textarea>
                </div>
            </div>
            <div class="travaux_card_content">
                <span class="travaux_card_subtitle">Document(s) Associé(s)</span>
                <span class="travaux_add_files">Téléverser des documents avec des informations spécifiques au chantier (max 10Mo)</span>
                <input type="file" id="fileInput_{{feature_ol_uid}}" accept=".pdf" multiple>
                <label for="fileInput_{{feature_ol_uid}}" id="fileInput_button_{{feature_ol_uid}}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3 19H21V21H3V19ZM13 5.82843V17H11V5.82843L4.92893 11.8995L3.51472 10.4853L12 2L20.4853 10.4853L19.0711 11.8995L13 5.82843Z"></path></svg>
                    Téléverser un document
                </label>
                <table id="filesList_{{feature_ol_uid}}" class="ms-2">
                    <tbody></tbody>
                </table>
            </div>
            <div class="buttons_container">
                <input id="annuler" class="btn__grey" type="button" value="Annuler" />
                <input id="valider" class="btn__default" type="submit" value="Enregistrer" />
            </div>
        </form>
	</div>
</li>
<script>
    const naturesTravaux = {
        EP: "Travaux sur le réseau d'eau potable",
        ENP: "Travaux sur le réseau d'eau non potable",
        INSTALL_RES: "Travaux sur les installations du réseau ou sur les réservoirs",
        GENIE_CIVIL: "Travaux de génie civil sur les galeries abritant des canalisations d'eau	",
        Null: "Type de travaux non renseigné",
        Autre: "Autre"
    }

    const typesChantier = {
        RC: "Renouvellement de canalisations",
        RBI: "Remplacement de bouche incendie",
        RV: "Remplacement de vannes",
        RCSI: "Renforcement de canalisations lié à la sécurité incendie",
        IU: "Intervention d'urgence",
        RAH: "Remplacement d'appareils hydrauliques",
        TIRR: "Travaux sur les installations du réseau ou sur les réservoirs",
        TGC: "Travaux de génie civil sur les galeries abritant des canalisations d'eau"
    }

    const correspondancesNaturesTypes = {
        EP: ['RC', 'RBI', 'RV', 'RCSI', 'IU', 'RAH'],
        ENP: ['RC', 'RV', 'IU', 'RAH'],
        INSTALL_RES: ['TIRR'],
        GENIE_CIVIL: ['TGC', 'IU']
    }

    const impact = {
        IntePonctuelles: "Ces travaux nécessiteront 2 interruptions de service ponctuelles. Celles-ci seront annoncées a minima 48h à l’avance par voie d’affichage dans vos immeubles.",
        NoImpact: "Ces travaux n’ont pas d’impact sur la distribution d’eau potable",
        IU: "Intervention d'urgence"
    }

    const correspondancesTypesImpact = {
        RC: "IntePonctuelles",
        RBI: "NoImpact",
        RV: "IntePonctuelles",
        RCSI: "IntePonctuelles",
        IU: "IU",
        RAH: "NoImpact",
        TIRR: "NoImpact",
        TGC: "NoImpact"
    }

    // Select Nature Chantier
    const selectNatureChantier = document.getElementById("select_nature_chantier_{{feature_ol_uid}}");
    for (const travaux in naturesTravaux) {
        const natureOption = document.createElement("option");
        natureOption.value = travaux;
        natureOption.textContent = naturesTravaux[travaux];
        selectNatureChantier.appendChild(natureOption);
    }

    // Select Type Chantier
    document.getElementById("select_nature_chantier_{{feature_ol_uid}}").addEventListener("change", function() {
        const selectTypeChantier =document.getElementById('select_type_chantier_{{feature_ol_uid}}');
        const natureChantierValue = selectNatureChantier.value;

        document.getElementById('autre_form_{{feature_ol_uid}}').style.display = "none";
        document.getElementById('form_{{feature_ol_uid}}').style.display = "block";
        selectTypeChantier.innerHTML = "<option value=''>Sélectionnez un type</option>";
        
        if (natureChantierValue === "Autre") {
            document.getElementById('autre_form_{{feature_ol_uid}}').style.display = "block";
            document.getElementById('form_{{feature_ol_uid}}').style.display = "none";
        }

        if (correspondancesNaturesTypes[natureChantierValue]) {
            correspondancesNaturesTypes[natureChantierValue].forEach(type => {
                const typeOption = document.createElement("option")
                typeOption.value = type;
                typeOption.textContent = typesChantier[type];
                selectTypeChantier.appendChild(typeOption);
            });
        }

        const selectType = document.getElementById("select_type_chantier_{{feature_ol_uid}}");
        const textImpact = document.getElementById("travaux_impact_{{feature_ol_uid}}");
        if (this.value) {
            selectType.disabled = false;
            textImpact.disabled = false;
        } else {
            selectType.disabled = true;
            textImpact.disabled = true;
        }
    });

    document.getElementById("select_type_chantier_{{feature_ol_uid}}").addEventListener("change", function() {
        const selectTypeChantier =document.getElementById('select_type_chantier_{{feature_ol_uid}}');
        const impactTravaux =document.getElementById('travaux_impact_{{feature_ol_uid}}');
        const typeChantierValue = selectTypeChantier.value;
        impactTravaux.innerHTML = "Impact des travaux...";

        if (correspondancesTypesImpact[typeChantierValue]) {
            const impactKey = correspondancesTypesImpact[typeChantierValue];            
            impactTravaux.innerHTML = impact[impactKey];
        }
    });

    // Upload de fichiers
    const fileInput = document.getElementById('fileInput_{{feature_ol_uid}}');
    const filesTableBody = document.getElementById('filesList_{{feature_ol_uid}}');
    let selectedFiles = [];
    const maxFileSize = 10 * 1024 * 1024;

    fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files);
        validFiles = [];        
        files.forEach(file => {
            if (file.size <= maxFileSize) {
                validFiles.push(file);
            } else {
                alert(`Le fichier "${file.name}" dépasse la taille maximale autorisée (5 Mo).`);
            }
        });
        selectedFiles = validFiles;
        renderTable();
    });

    function renderTable () {
        selectedFiles.forEach((file, index) => {
            const row = document.createElement('tr');
            const nameCell = document.createElement('td');
            nameCell.textContent = file.name;
            
            // Bouton de visualisation
            const viewBtn = document.createElement('button');
            viewBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748ZM12.1779 7.17624C11.4834 7.48982 11 8.18846 11 9C11 10.1046 11.8954 11 13 11C13.8115 11 14.5102 10.5166 14.8238 9.82212C14.9383 10.1945 15 10.59 15 11C15 13.2091 13.2091 15 11 15C8.79086 15 7 13.2091 7 11C7 8.79086 8.79086 7 11 7C11.41 7 11.8055 7.06167 12.1779 7.17624Z"></path></svg>';
            viewBtn.className = 'actionButton';
            viewBtn.onclick = () => {
                event.preventDefault();
                const fileURL = URL.createObjectURL(file);
                window.open(fileURL, '_blank');
            };

            // Bouton de suppression
            const actionCell = document.createElement('td');
            actionCell.style = 'display: flex; justify-content: end;';
            const deleteBtn = document.createElement('button');
            deleteBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17 6H22V8H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V8H2V6H7V3C7 2.44772 7.44772 2 8 2H16C16.5523 2 17 2.44772 17 3V6ZM18 8H6V20H18V8ZM9 11H11V17H9V11ZM13 11H15V17H13V11ZM9 4V6H15V4H9Z"></path></svg>';
            deleteBtn.className = 'actionButton';
            deleteBtn.onclick = () => {
                selectedFiles.splice(index, 1);
                renderTable();
            };

            actionCell.appendChild(viewBtn);
            actionCell.appendChild(deleteBtn);
            row.appendChild(nameCell);
            row.appendChild(actionCell);
            filesTableBody.appendChild(row);
        });
    }

</script>
<style>

.carousel-inner {
    overflow: visible !important;
}

#page-content-wrapper:has(#right-panel.active) #zoomtoolbar,
  #page-content-wrapper:has(#right-panel.active) #toolstoolbar {
    margin-right: 420px !important;
}

#right-panel.active {
    width: 420px!important;
}

#right-panel .item.active {
    padding: 0;
}
#right-panel .carousel-control {
    width: 5%;
}
#right-panel span.counter-slide {
    left: auto;
    right: 186px!important;
}

.travaux_card_container {
    font-size: 15px;
    font-family: var(--myfont);
    color: #002DDC;
}
.travaux_card_container select:not(:disabled):hover, 
.travaux_card_container button:hover, 
.travaux_card_container #fileInput_button_{{feature_ol_uid}}:hover{
    cursor:pointer;
}
.travaux_card_ref_chantier{
    font-weight: 600;
    font-size: 18px;
}
.travaux_card_title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 25px;
}
.travaux_card_subtitle {
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 6px;
}
.travaux_card_content {
    display: flex;
    flex-direction: column;
    margin: 20px 0px;
}
.travaux_card_content_select {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 20px 0px;
}
.travaux_card_container select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    position: relative;
    padding: 10px;
    background-color: white;
    border-radius: 15px;
    border: solid 2px #002DDC;
}
.travaux_card_content_select::after{
    content: "▼"; /* Ou "\25BC" (Unicode du chevron) */
    font-size: 14px;
    color: #002ddc;
    position: absolute;
    right: 15px;
    top: 54%;
    pointer-events: none;
}
.travaux_impact{
    min-height: 10em;
    padding: 10px;
    border-radius: 15px;
    border: solid 2px #002DDC;
    background-color: white;
}
.travaux_card_content input, .travaux_card_content textarea {
    padding: 10px;
    background-color: white;
    border-radius: 15px;
    border: solid 2px #002DDC;
    resize: none;
}
.autre_impact_chantier{
    height: 10em;
}
.autre_form {
    display: none;
}
.buttons_container {
    margin-top: 1em;
    display: flex;
    justify-content: end;
    gap: 15px;
}
.buttons_container input {
    border: none;
    border-radius: 18px;
    padding: 6px 18px;
    transition: all 1s ease-out;
}
.btn__default{
    background-color: #002DDC;
    color: white;
} 
.btn__yellow{
    background-color:rgb(209, 209, 209);
    color: #002DDC;
}

.travaux_add_files{
    color: #002DDC;
    font-style: italic;
    font-size: smaller;
}

#fileInput_{{feature_ol_uid}} {
    display: none;
}

#fileInput_button_{{feature_ol_uid}} {
    margin-top: 1rem;
    font-weight: 600;
    background-color:#c6cff3ab;
    color: #002DDC;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 15px;
    padding: 12px;
    transition: all 1s ease-out;
}

#fileInput_button_{{feature_ol_uid}}:hover, .buttons_container input:hover {
    opacity:0.7;
    cursor:pointer;
}

#filesList{
    margin: 1em 0;
    border-bottom: 1px solid #002ddc29;
}

.actionButton {
    background-color: white;
    outline: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
}

.actionButton:hover {
    opacity:.8;
}

.travaux_card_container textarea:disabled, 
.travaux_card_container select:disabled,
.travaux_card_container span:has(+ *:disabled),
.travaux_card_container label:has(+ select:disabled){
    opacity: 0.4!important;
}

#form_179:has(select:disabled) ::after{
    opacity: 0.4!important;
}

#filesList tr {
    padding: 10px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

</style>
{{/features}}