{{#features}}
<li id="{{feature_ol_uid}}" class="item" style="width:100%;">	
	<div id="container" class="travaux_card_container">
		<div id="travaux_card_nature_chantier_{{feature_ol_uid}}" class="travaux_card_title">Editer les informations</div>
        <div class="travaux_card_ref_chantier">Référence Chantier : {{num_emprise}}</div>
        <form>
            <div class="travaux_card_content_select">
                <label for="select_nature_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Nature du chantier</label>
                <select id="select_nature_chantier_{{feature_ol_uid}}">
                    <option value="">Séléctionnez une nature de chantier...</option>
                </select>
            </div>
            <div id="form_{{feature_ol_uid}}">
                <div class="travaux_card_content_select">
                    <label for="select_type_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Type de chantier</label>
                    <select id="select_type_chantier_{{feature_ol_uid}}" disabled>
                        <option value="">Séléctionnez un type de chantier...</option>
                    </select>
                </div>
                <div class="travaux_card_content">
                    <span class="travaux_card_subtitle">Impact</span>
                    <span id="travaux_impact_{{feature_ol_uid}}" class="travaux_impact"></span>
                </div>
            </div>
            <div id="autre_form_{{feature_ol_uid}}" class="autre_form">
                <div class="travaux_card_content">
                    <label for="input_autre_nature_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Précisez la nature du chantier</label>
                    <input type="text" id="input_autre_nature_chantier_{{feature_ol_uid}}"></input>
                </div>
                <div class="travaux_card_content">
                    <label for="input_autre_type_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Précisez le type de chantier</label>
                    <input type="text" id="input_autre_type_chantier_{{feature_ol_uid}}"></input>
                </div>
                <div class="travaux_card_content">
                    <label for="autre_impact_chantier_{{feature_ol_uid}}" class="travaux_card_subtitle">Précisez l'impact</label>
                    <textarea id="autre_impact_chantier_{{feature_ol_uid}}" class="autre_impact_chantier"></textarea>
                </div>
            </div>
            <div class="travaux_card_content">
                <span class="travaux_card_subtitle">Document(s) Associé(s)</span>
                <span class="travaux_add_files">Téléverser des documents avec des informations spécifiques au chantier </br> (Max 5Mo) </span>
                <input type="file" id="fileInput" accept=".pdf" multiple>
                <label for="fileInput" id="fileInput_button"><i id="uploadIcon" class="fas fa-upload fa-lg"></i>Téléverser un document</label>
                <table id="filesList" class="ms-2">
                    <tbody></tbody>
                </table>
            </div>
            <div class="buttons_container">
                <input id="annuler" type="button" value="Annuler" />
                <input id="valider" type="submit" value="Valider" />
            </div>
        </form>
	</div>
</li>
<script>
    const naturesTravaux = {
        EP: "Travaux sur le réseau d'eau potable",
        ENP: "Travaux sur le réseau d'eau non potable",
        INSTALL_RES: "Travaux sur les installations du réseau ou sur les réservoirs",
        GENIE_CIVIL: "Travaux de génie civil sur les galeries abritant des canalisations d'eau	",
        Null: "Type de travaux non renseigné",
        Autre: "Autre"
    }

    const typesChantier = {
        RC: "Renouvellement de canalisations",
        RBI: "Remplacement de bouche incendie",
        RV: "Remplacement de vannes",
        RCSI: "Renforcement de canalisations lié à la sécurité incendie",
        IU: "Intervention d'urgence",
        RAH: "Remplacement d'appareils hydrauliques",
        TIRR: "Travaux sur les installations du réseau ou sur les réservoirs",
        TGC: "Travaux de génie civil sur les galeries abritant des canalisations d'eau"
    }

    const correspondancesNaturesTypes = {
        EP: ['RC', 'RBI', 'RV', 'RCSI', 'IU', 'RAH'],
        ENP: ['RC', 'RV', 'IU', 'RAH'],
        INSTALL_RES: ['TIRR'],
        GENIE_CIVIL: ['TGC', 'IU']
    }

    const impact = {
        IntePonctuelles: "Ces travaux nécessiteront 2 interruptions de service ponctuelles. Celles-ci seront annoncées a minima 48h à l’avance par voie d’affichage dans vos immeubles.",
        NoImpact: "Ces travaux n’ont pas d’impact sur la distribution d’eau potable",
        IU: "Intervention d'urgence"
    }

    const correspondancesTypesImpact = {
        RC: "IntePonctuelles",
        RBI: "NoImpact",
        RV: "IntePonctuelles",
        RCSI: "IntePonctuelles",
        IU: "IU",
        RAH: "NoImpact",
        TIRR: "NoImpact",
        TGC: "NoImpact"
    }

    // Select Nature Chantier
    const selectNatureChantier = document.getElementById("select_nature_chantier_{{feature_ol_uid}}");
    for (const travaux in naturesTravaux) {
        const natureOption = document.createElement("option");
        natureOption.value = travaux;
        natureOption.textContent = naturesTravaux[travaux];
        selectNatureChantier.appendChild(natureOption);
    }

    // Select Type Chantier
    document.getElementById("select_nature_chantier_{{feature_ol_uid}}").addEventListener("change", function() {
        const selectTypeChantier =document.getElementById('select_type_chantier_{{feature_ol_uid}}');
        const natureChantierValue = selectNatureChantier.value;

        document.getElementById('autre_form_{{feature_ol_uid}}').style.display = "none";
        document.getElementById('form_{{feature_ol_uid}}').style.display = "block";
        selectTypeChantier.innerHTML = "<option value=''>Sélectionnez un type</option>";
        
        if (natureChantierValue === "Autre") {
            document.getElementById('autre_form_{{feature_ol_uid}}').style.display = "block";
            document.getElementById('form_{{feature_ol_uid}}').style.display = "none";
        }

        if (correspondancesNaturesTypes[natureChantierValue]) {
            correspondancesNaturesTypes[natureChantierValue].forEach(type => {
                const typeOption = document.createElement("option")
                typeOption.value = type;
                typeOption.textContent = typesChantier[type];
                selectTypeChantier.appendChild(typeOption);
            });
        }

        const selectType = document.getElementById("select_type_chantier_{{feature_ol_uid}}");
        if (this.value) {
            selectType.disabled = false;
        } else {
            selectType.disabled = true;
        }
    });

    document.getElementById("select_type_chantier_{{feature_ol_uid}}").addEventListener("change", function() {
        const selectTypeChantier =document.getElementById('select_type_chantier_{{feature_ol_uid}}');
        const impactTravaux =document.getElementById('travaux_impact_{{feature_ol_uid}}');
        const typeChantierValue = selectTypeChantier.value;
        impactTravaux.innerHTML = "Impact des travaux...";

        if (correspondancesTypesImpact[typeChantierValue]) {
            const impactKey = correspondancesTypesImpact[typeChantierValue];            
            impactTravaux.innerHTML = impact[impactKey];
        }
    });

    // Upload de fichiers
    const fileInput = document.getElementById('fileInput');
    const filesTableBody = document.getElementById('filesList');
    let selectedFiles = [];
    const maxFileSize = 5 * 1024 * 1024;

    fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files);
        validFiles = [];
        
        files.forEach(file => {
            if (file.size <= maxFileSize) {
                validFiles.push(file);
            } else {
                alert(`Le fichier "${file.name}" dépasse la taille maximale autorisée (5 Mo).`);
            }
        });

        selectedFiles = validFiles;
        renderTable();
    });

    function renderTable () {
        filesTableBody.innerHTML = "";
        selectedFiles.forEach((file, index) => {
            const row = document.createElement('tr');
            const nameCell = document.createElement('td');
            nameCell.textContent = file.name;
            
            // Bouton de visualisation
            const viewBtn = document.createElement('button');
            viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
            viewBtn.className = 'btn btn-sm actionButton';
            viewBtn.onclick = () => {
                event.preventDefault();
                const fileURL = URL.createObjectURL(file);
                window.open(fileURL, '_blank');
            };

            // Bouton de suppression
            const actionCell = document.createElement('td');
            actionCell.style = 'display: flex; justify-content: end;';
            const deleteBtn = document.createElement('button');
            deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
            deleteBtn.className = 'btn btn-sm actionButton';
            deleteBtn.onclick = () => {
                selectedFiles.splice(index, 1);
                renderTable();
            };

            actionCell.appendChild(viewBtn);
            actionCell.appendChild(deleteBtn);
            row.appendChild(nameCell);
            row.appendChild(actionCell);
            filesTableBody.appendChild(row);
        });
    }

</script>
<style>
.travaux_card_container {
    padding: 10px;
    min-height: 300px;
    border-radius: 5%;
    position: relative;
    overflow: visible;
}
#container{
    background-color: rgb(255, 255, 255);
}
.travaux_card_ref_chantier{
    font-family: var(--myfont);
    font-weight: bold;
    color: #002DDC;
}
.travaux_card_title {
    font-family: var(--myfont);
    text-transform: uppercase;
    color: #002DDC;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 25px;
}
.travaux_card_nature_chantier {
    background-color: rgba(170, 184, 255, 0.8);
    border-radius: 10px;
    text-align: center;
    text-decoration: none;
    padding: 2px 5px;
}
.travaux_card_subtitle {
    text-transform: uppercase;
    color: #002DDC;
    font-weight: bold;
}
.travaux_card_content {
    font-family: var(--myfont);
    display: flex;
    flex-direction: column;
    margin-top: 10px;
}
.travaux_card_message_container {
    font-family: var(--myfont);
    background-color: white;
    border-radius: 10px;
    padding: 5px;
    margin: 10px 0;
}
.travaux_card_informations_container {
    border-top: solid 1px #002DDC;
    margin-top: 10px;
    padding-bottom: 5px;
}
.more_info{
    display: flex;
    justify-content: space-between;
    margin-top: 5px;
    color: #002DDC;
    font-weight: bold;
    cursor: pointer;
}
.travaux_card_content_select {
    position: relative;
    font-family: var(--myfont);
    display: flex;
    flex-direction: column;
    margin-top: 10px;
}
select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    position: relative;
    height: 40px;
    padding: 5px;
    background-color: white;
    border-radius: 10px;
    border: solid 2px #002DDC;
}
.travaux_card_content_select::after{
    content: "▼"; /* Ou "\25BC" (Unicode du chevron) */
    font-size: 14px;
    color: #002DDC;
    position: absolute;
    right: 10px;
    top: 50%;
    pointer-events: none;
}
.travaux_impact{
    min-height: 100px;
    padding: 5px;
    border-radius: 10px;
    border: solid 2px #002DDC;
    background-color: white;
}
.travaux_card_content input, textarea {
    height: 40px;
    padding: 5px;
    background-color: white;
    border-radius: 10px;
    border: solid 2px #002DDC;
}
.autre_impact_chantier{
    height: 100px;
}
select:focus, input:focus, textarea:focus {
    outline: #728beb;
}
.autre_form {
    display: none;
}
.buttons_container {
    font-family: var(--myfont);
    margin-top: 20px;
    display: flex;
    justify-content: end;
    gap: 15px;
}
.buttons_container input {
    color: white;
    background-color: #002DDC;
    border: none;
    border-radius: 10px;
    padding: 5px 15px;
    font-weight: bold;
}
.panel-body {
    padding: 0 !important;
}
.carousel-inner {
    overflow: visible !important;
}

#page-content-wrapper:has(#right-panel.active) #zoomtoolbar,
  #page-content-wrapper:has(#right-panel.active) #toolstoolbar {
    margin-right: 420px !important;
}

#right-panel.active {
    width: 420px!important;
}

.travaux_add_files{
    font-family: var(--myfont);
    color: #002DDC;
    font-style: italic;
    font-size: smaller;
}

#fileInput {
    display: none;
}

#fileInput_button {
    margin-top: 1rem;
    font-family: var(--myfont);
    font-weight: 600;
    background-color: #c6cff3;
    color: #002DDC;
    display: flex;
    justify-content: center;
    height: 40px;
    align-items: center;
    border-radius: 10px;
}

#uploadIcon {
    margin-right: 5px;
}

#filesList{
    color: #002DDC;
    font-family: var(--myfont);
}

.actionButton {
    background-color: white;
    color: #002DDC;
}

</style>
{{/features}}