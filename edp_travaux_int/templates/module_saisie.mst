{{#features}}
<li id="{{feature_ol_uid}}" class="item" style="width:100%;">	
	<div id="container_{{nature_chantier}}" class="travaux_card_container">
		<div id="travaux_card_nature_chantier_{{feature_ol_uid}}" class="travaux_card_title">Editer les informations</div>
        <div class="travaux_card_ref_chantier">Référence Chantier : {{num_emprise}}</div>
        <form>
            <div class="travaux_card_content_select">
                <label for="select_nature_chantier" class="travaux_card_subtitle">Nature du chantier</label>
                <select id="select_nature_chantier">
                    <option value="">Séléctionnez une nature de chantier...</option>
                </select>
            </div>
            <div class="travaux_card_content_select">
                <label for="select_type_chantier" class="travaux_card_subtitle">Type de chantier</label>
                <select id="select_type_chantier" disabled>
                    <option value="">Séléctionnez un type de chantier...</option>
                </select>
            </div>
            <div class="travaux_card_content">
                <span class="travaux_card_subtitle">Impact</span>
                <span id="travaux_impact"></span>
            </div>
        </form>
	</div>
</li>
<script>
    const naturesTravaux = {
        EP: "Travaux sur le réseau d'eau potable",
        ENP: "Travaux sur le réseau d'eau non potable",
        INSTALL_RES: "Travaux sur les installations du réseau ou sur les réservoirs",
        GENIE_CIVIL: "Travaux de génie civil sur les galeries abritant des canalisations d'eau	",
        Null: "Type de travaux non renseigné"
    }

    const typesChantier = {
        RC: "Renouvellement de canalisations",
        RBI: "Remplacement de bouche incendie",
        RV: "Remplacement de vannes",
        RCSI: "Renforcement de canalisations lié à la sécurité incendie",
        IU: "Intervention d'urgence",
        RAH: "Remplacement d'appareils hydrauliques",
        TIRR: "Travaux sur les installations du réseau ou sur les réservoirs",
        TGC: "Travaux de génie civil sur les galeries abritant des canalisations d'eau"
    }

    const correspondancesNaturesTypes = {
        EP: ['RC', 'RBI', 'RV', 'RCSI', 'IU', 'RAH'],
        ENP: ['RC', 'RV', 'IU', 'RAH'],
        INSTALL_RES: ['TIRR'],
        GENIE_CIVIL: ['TGC', 'IU']
    }

    const impact = {
        IntePonctuelles: "Ces travaux nécessiteront 2 interruptions de service ponctuelles. Celles-ci seront annoncées a minima 48h à l’avance par voie d’affichage dans vos immeubles.",
        NoImpact: "Ces travaux n’ont pas d’impact sur la distribution d’eau potable",
        IU: "Intervention d'urgence"
    }

    const correspondancesTypesImpact = {
        RC: "IntePonctuelles",
        RBI: "NoImpact",
        RV: "IntePonctuelles",
        RCSI: "IntePonctuelles",
        IU: "IU",
        RAH: "NoImpact",
        TIRR: "NoImpact",
        TGC: "NoImpact"
    }

    // Select Nature Chantier
    const selectNatureChantier = document.getElementById("select_nature_chantier");
    for (const travaux in naturesTravaux) {
        const natureOption = document.createElement("option");
        natureOption.value = travaux;
        natureOption.textContent = naturesTravaux[travaux];
        selectNatureChantier.appendChild(natureOption);
    }

    // Select Type Chantier
    document.getElementById("select_nature_chantier").addEventListener("change", function() {
        const selectTypeChantier =document.getElementById('select_type_chantier');
        const natureChantierValue = selectNatureChantier.value;
        
        selectTypeChantier.innerHTML = "<option value=''>Sélectionnez un type</option>";
        
        if (correspondancesNaturesTypes[natureChantierValue]) {
            correspondancesNaturesTypes[natureChantierValue].forEach(type => {
                const typeOption = document.createElement("option")
                typeOption.value = type;
                typeOption.textContent = typesChantier[type];
                selectTypeChantier.appendChild(typeOption);
            });
        }

        const selectType = document.getElementById("select_type_chantier");
        if (this.value) {
            selectType.disabled = false;
        } else {
            selectType.disabled = true;
        }
    });

    document.getElementById("select_type_chantier").addEventListener("change", function() {
        const selectTypeChantier =document.getElementById('select_type_chantier');
        const impactTravaux =document.getElementById('travaux_impact');
        const typeChantierValue = selectTypeChantier.value;
        impactTravaux.innerHTML = "Impact des travaux...";

        if (correspondancesTypesImpact[typeChantierValue]) {
            const impactKey = correspondancesTypesImpact[typeChantierValue];            
            impactTravaux.innerHTML = impact[impactKey];
        }
    });

    if ("{{nature_chantier}}" === "EP") {
        // document.getElementById("travaux_card_nature_chantier_{{feature_ol_uid}}").style.backgroundColor = "rgba(170, 184, 255, 1)";
    } else if ("{{nature_chantier}}" === "ENP") {
        // document.getElementById("travaux_card_nature_chantier_{{feature_ol_uid}}").style.backgroundColor = "rgba(255, 239, 170, 1)";
    } else if ("{{nature_chantier}}" === "INSTALL_RES") {
        // document.getElementById("travaux_card_nature_chantier_{{feature_ol_uid}}").style.backgroundColor = "rgba(174, 255, 174, 1)";
    } else if ("{{nature_chantier}}" === "GENIE_CIVIL") {
        // document.getElementById("travaux_card_nature_chantier_{{feature_ol_uid}}").style.backgroundColor = "rgba(255, 199, 151, 1)";
    } else if ("{{nature_chantier}}" === "null") {
        // document.getElementById("travaux_card_nature_chantier_{{feature_ol_uid}}").style.backgroundColor = "rgba(226, 226, 226, 1)";
    }

    // Accordéon Plus d'infos
    function toggleInfo (element) {
        let container = element.nextElementSibling;
        container.classList.toggle("open");

        let chevron = element.querySelector(".glyphicon");
        if (container.classList.contains("open")) {
            chevron.classList.remove("glyphicon-chevron-down");
            chevron.classList.add("glyphicon-chevron-up");
        } else {
            chevron.classList.remove("glyphicon-chevron-up");
            chevron.classList.add("glyphicon-chevron-down");
        }
    }

</script>
<style>
.travaux_card_container {
    padding: 10px;
    min-height: 300px;
    border-radius: 5%;
    position: relative;
    overflow: visible;
}
#container_EP {
    background-color: rgba(170, 184, 255, 0.5);
}
#container_ENP {
    background-color: rgba(255, 239, 170, 0.5);
}
#container_INSTALL_RES {
    background-color: rgba(174, 255, 174, 0.5);
}
#container_GENIE_CIVIL {
    background-color: rgba(255, 199, 151, 0.5);
}
#container_null {
    background-color: rgba(226, 226, 226, 0.5);
}
.travaux_card_ref_chantier{
    font-family: var(--myfont);
    font-weight: bold;
    color: #002DDC;
}
.travaux_card_title {
    font-family: var(--myfont);
    text-transform: uppercase;
    color: #002DDC;
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 25px;
}
.travaux_card_nature_chantier {
    background-color: rgba(170, 184, 255, 0.8);
    border-radius: 10px;
    text-align: center;
    text-decoration: none;
    padding: 2px 5px;
}
.travaux_card_subtitle {
    text-transform: uppercase;
    color: #002DDC;
    font-weight: bold;
}
.travaux_card_content {
    font-family: var(--myfont);
    display: flex;
    flex-direction: column;
    margin-top: 10px;
}
.travaux_card_message_container {
    font-family: var(--myfont);
    background-color: white;
    border-radius: 10px;
    padding: 5px;
    margin: 10px 0;
}
.travaux_card_informations_container {
    border-top: solid 1px #002DDC;
    margin-top: 10px;
    padding-bottom: 5px;
}
.more_info{
    display: flex;
    justify-content: space-between;
    margin-top: 5px;
    color: #002DDC;
    font-weight: bold;
    cursor: pointer;
}
.travaux_card_button{
    background-color: #002ddc00;
    border: solid 2px #002ddc;
    border-radius: 20px;
    color: #002ddc;
    text-align: center;
    text-decoration: none;
    padding: 5px 5px;
    font-family: var(--myfont);
    font-weight: bold;
}
.travaux_card_button_info {
    font-family: var(--myfont);
    margin-top: 10px;
    width: 100%;
    height: 3rem;
    background-color: #002DDC;
    border: none;
    border-radius: 12px;
    color: white;
    text-align: center;
    text-decoration: none;
    padding: 2px 5px;
}
.travaux_card_button_container {
    max-height: 0px;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
    margin-top: 10px;
    display: flex;
    justify-content: space-evenly;
    width: 100%;
}
.travaux_card_button_container.open {
    max-height: 100px;
}
.travaux_card_content_select {
    position: relative;
    font-family: var(--myfont);
    display: flex;
    flex-direction: column;
    margin-top: 10px;
}
select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    position: relative;
    height: 40px;
    padding: 5px;
    background-color: white;
    border-radius: 10px;
    border: solid 2px #002DDC;
}
.travaux_card_content_select::after{
    content: "▼"; /* Ou "\25BC" (Unicode du chevron) */
    font-size: 14px;
    color: #002DDC;
    position: absolute;
    right: 10px;
    top: 50%;
    pointer-events: none;
}
#travaux_impact{
    min-height: 100px;
    padding: 5px;
    border-radius: 10px;
    border: solid 2px #002DDC;
    background-color: white;
}
.panel-body {
    padding: 0 !important;
}
.carousel-inner {
    overflow: visible !important;
}

#page-content-wrapper:has(#right-panel.active) #zoomtoolbar,
  #page-content-wrapper:has(#right-panel.active) #toolstoolbar {
    margin-right: 420px !important;
}

#right-panel.active {
    width: 420px!important;
}
</style>
{{/features}}