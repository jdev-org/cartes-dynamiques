{{#features}}
<li id="{{unique_id}}" class="item" style="width:100%;">	
	<div id="container_{{nature_code_chantier}}" class="travaux_card_container">
		<div id="travaux_card_nature_chantier_{{unique_id}}" class="travaux_card_title">            
            {{#nature_chantier}}
                {{nature_chantier}}
            {{/nature_chantier}}
            {{^nature_chantier}}
                Non renseigné
            {{/nature_chantier}}
        </div>
        {{#impact_chantier}}
        <div class="travaux_card_message_container">
            {{impact_chantier}}
        </div>
        {{/impact_chantier}}
        <div class="travaux_card_content">
            <span class="travaux_card_subtitle">Localisation</span>
            <span>{{nom_rue}}, {{cp_arrondissement}} PARIS</span>
        </div>
        <div class="travaux_card_content">
            <span class="travaux_card_subtitle">Motif des travaux</span>
            <span>  
                {{#type_chantier}}
                    {{type_chantier}}
                {{/type_chantier}}
                {{^type_chantier}}
                    Non renseigné
                {{/type_chantier}}
            </span>
        </div>

        <div class="travaux_card_content">
            <span class="travaux_card_subtitle">Période prévue des travaux</span>
            <span id="travaux_card_date_{{unique_id}}"></span>
        </div>
        <!-- Lettre d'info-->
        <a href="#" class="travaux_card_button_info {{nature_chantier}}" id="btnLettreInfo">
            Consulter la lettre d'info
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 22H4C3.44772 22 3 21.5523 3 21V3C3 2.44772 3.44772 2 4 2H20C20.5523 2 21 2.44772 21 3V21C21 21.5523 20.5523 22 20 22ZM19 20V4H5V20H19ZM8 7H16V9H8V7ZM8 11H16V13H8V11ZM8 15H16V17H8V15Z"></path></svg>
        </a>
        <div class="accordionChant__infoMult {{nature_chantier}}" id="accordionLettreInfo">
            <div class="accordion__header" onclick="toggleInfo(this)">
                <span>Consulter les lettres d'info</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M13.1717 12.0007L8.22192 7.05093L9.63614 5.63672L16.0001 12.0007L9.63614 18.3646L8.22192 16.9504L13.1717 12.0007Z"></path></svg>
            </div>
            <div class="accordion__body"></div>            
        </div>
        <div class="btn_container">
            <a href="https://www.eaudeparis.fr/travaux-sur-nos-reseaux" target="_blank" class="travaux_card_button">En savoir plus</a>
            <a href="https://dansmarue.paris.fr/dansmarue/jsp/site/Portal.jsp?page=fodansmarue" target="_blank" class="travaux_card_button">Une anomalie ?</a>
        </div>
	</div>
</li>
<script>
    const unique_id=  "{{unique_id}}"
    fetchFiles(unique_id)

    // Customize le CSS selon la nature des travaux
    const naturesTravaux = {
        EP: "Travaux sur le réseau d'eau potable",
        ENP: "Travaux sur le réseau d'eau non potable",
        INSTALL_RES: "Travaux sur les installations ou sur les réservoirs",
        GENIE_CIVIL: "Travaux de génie civil sur les galeries abritant des canalisations d'eau",
        Null: "Non renseigné"
    }

    const nature = "{{nature_chantier}}";
    const travauxCardNatureChantier = document.getElementById("travaux_card_nature_chantier_{{unique_id}}");

    if (naturesTravaux[nature] !== undefined) {
        travauxCardNatureChantier.innerHTML += naturesTravaux[nature];
        const backgroundColors = {
            EP: "rgba(170, 184, 255, 1)",
            ENP: "rgba(255, 239, 170, 1)",
            INSTALL_RES: "rgba(174, 255, 174, 1)",
            GENIE_CIVIL: "rgba(255, 199, 151, 1)",
            Null: "rgba(226, 226, 226, 1)",
            Autre: "rgba(237, 171, 243, 1)"
        }
        travauxCardNatureChantier.style.backgroundColor = backgroundColors[nature];
    }

    // Affichage des dates
    const dateDebut = "{{date_debut}}";
    const dateFin = "{{date_fin}}";
    const dateDebutReader = moment(dateDebut, "YYYYMMDDHHmmss");
    const dateDebutOutput = dateDebutReader.format("DD/MM/YYYY");
    const dateFinReader = moment(dateFin, "YYYYMMDDHHmmss");
    const dateFinOutput = dateFinReader.format("DD/MM/YYYY");
    document.getElementById("travaux_card_date_{{unique_id}}").innerHTML = `Du ${dateDebutOutput} au ${dateFinOutput}`;


    // Accordéon Plus d'infos
    function toggleInfo (element) {
        let container = element.nextElementSibling;
        container.classList.toggle("open");
        element.classList.toggle("open");
    }

    // Get documents associés
    associatedFiles = [];
    const lettreInfo = document.getElementById('btnLettreInfo');
    const listeLettresInfo = document.getElementById('accordionLettreInfo');
    async function fetchFiles(uniqueId) {
        const response = await fetch(`https://gis.jdev.fr/edp/documents/${uniqueId}/`);
        if (response.status === 404) {
            return;
        }
        if (!response.ok) {
            console.error("Erreur lors de la récupération des fichiers :", response.status);
            return;
        }
        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser .parseFromString(html, "text/html");
        const links = [...doc.querySelectorAll("a")];        
        const files = links.map(link => link.getAttribute('href')).filter(href => !href.startsWith("?")).slice(1)
        
        associatedFiles = [];
        associatedFiles = files;
        
        if (associatedFiles.length < 1) {
            lettreInfo.style.display = 'none';
            listeLettresInfo.style.display = 'none';
        }

        if (associatedFiles.length === 1) {
            lettreInfo.style.display = 'flex';
            listeLettresInfo.style.display = 'none';
            lettreInfo.onclick = (e) => {
                e.preventDefault();
                const fileURL = `https://gis.jdev.fr/edp/documents/${unique_id}/${associatedFiles[0]}`;
                window.open(fileURL, '_blank');
            }
        }

        if (associatedFiles.length > 1) {
            lettreInfo.style.display = 'none';
            listeLettresInfo.style.display = 'block';
            renderFilesList();
        }
    }

    function renderFilesList () {
        const accordeonBody = document.querySelector('.accordion__body');
        const list = document.createElement('ul');
        associatedFiles.forEach((file, index) => {
            const listItem = document.createElement('li');
            listItem.textContent = "- " + file;
            listItem.onclick = (e) => {
                event.preventDefault();
                const fileURL = `https://gis.jdev.fr/edp/documents/${unique_id}/${file}`;
                window.open(fileURL, '_blank');
            }
            list.appendChild(listItem); 
            accordeonBody.appendChild(list); 
        });
    }

</script>
<style>

/* Temp */ 
.accordionChant__infoMult:not(.GENIE_CIVIL){
    display:none;
}
#btnLettreInfo {
    display: none;
}
#btnLettreInfo.GENIE_CIVIL{
    display:none;
}

#container_ep {
    background-color: rgba(0, 44, 219, 0.2);
}
#container_enp {
    background-color: rgba(54,165,133, 0.2);
}
#container_install_res {
    background-color: rgba(245, 168, 108, 0.5);
}
#container_genie_civil {
    background-color: rgba(255, 100, 125, 0.5);
}
#container_nature_autre {
    background-color: rgba(243, 201, 239, 0.5);
}
#container_ {
    background-color: rgba(247, 236, 109, 0.5);
}

.travaux_card_container {
    padding: 2rem;
    border-radius: 1em;    
    font-family: var(--myfont);
}

.travaux_card_title {
    text-transform: uppercase;
    color: #002DDC;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.1;
}

.travaux_card_nature_chantier {
    background-color: rgba(170, 184, 255, 0.8);
    border-radius: 10px;
    text-align: center;
    text-decoration: none;
    padding: 2px 5px;
}

.travaux_card_subtitle {
    text-transform: uppercase;
    color: #002DDC;
    font-size: 13px;
    font-weight: 600;
}

.travaux_card_content {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
    font-size: 16px;
    color: #002DDC;
}

.travaux_card_message_container {
    background-color: white;
    border-radius: 10px;
    padding: 10px 10px;
    margin: 10px 0;
    color: #002DDC;
    line-height: 1.1;
}

/* Accordion */ 

.accordionChant__infoMult {
    font-size: 1.2rem;
    background-color: var(--mycolor);
    color: white;
    padding: 10px 15px;
    border-radius: 20px;
    width: 100%;
    margin-top: 1em;
}

.accordion__header{
    display: flex;
    justify-content: space-between;
    cursor: pointer;
}

.accordion__header svg{    
    transition: all .5s ease-out;
}

.accordion__header.open svg{
    transform: rotate(90deg);
}

.accordion__body{
    display:none;
}

.accordion__body.open{
    display:block;
}

.accordion__body a {
    color: white;
    display: flex;
    align-items: center;
    margin: 10px 0;
    font-weight: 500;
}

.accordion__body a svg {
    margin-right: 5px;
}

/* Btn */ 

.travaux_card_button{
    background-color: #ffffff00 !important;
    color: var(--mycolor);
    border: 0.16rem solid;
    font-weight: 600;
    font-size: 13px;
    padding: 6px 10px;
    border-radius: 2rem;
    display: inline-flex;
    align-items: center;
    margin: 0px 5px 5px 0px;
}

.travaux_card_button:hover{
    background-color: #ffffff00 !important;
    color: var(--mycolor)!important;
    border-color:var(--mycolor)!important;
}

.travaux_card_button_info {
    font-size: 1.2rem;
    background-color: var(--mycolor);
    color: white;
    padding: 10px 15px;
    border-radius: 2rem;
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin: 1em 0;
}

.travaux_card_button_info:hover{
    opacity:0.8;
    color: white!important;
}

#modal-panel .carousel-inner {
    padding: 5px !important;
}

#page-content-wrapper:has(#right-panel.active) #zoomtoolbar,
#page-content-wrapper:has(#right-panel.active) #toolstoolbar,
#page-content-wrapper:has(#right-panel.active) #backgroundlayerstoolbar-gallery {
    margin-right: 420px !important;
}

#right-panel.active {
    width: 420px!important;
}

#right-panel .item {
    padding-bottom: 1em;
}

#right-panel .list-group-item li {
    list-style: none;
}

#modal-panel #dataToggleDiv {
    display: none;
}

ul {
    padding-inline-start: 0 !important;
}

li {
    cursor: pointer;
}

.btn_container {
    margin-top: 1em;
}

</style>
{{/features}}